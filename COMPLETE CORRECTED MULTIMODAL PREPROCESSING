def find_col(df, candidates, required=True):
    lookup = {
        str(c).strip().lower(): c
        for c in df.columns
    }

    for name in candidates:
        if name.lower() in lookup:
            return lookup[name.lower()]

    if required:
        raise ValueError(
            f"Missing column. Tried: {candidates}\n"
            f"Available: {df.columns.tolist()}"
        )

    return None

