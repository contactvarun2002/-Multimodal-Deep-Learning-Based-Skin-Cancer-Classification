@torch.no_grad()
def probabilities(x, batch_size=64):
    out=[]
    for i in range(0,len(x),batch_size):
        z=torch.from_numpy(np.asarray(x[i:i+batch_size],dtype=np.float32)).to(DEVICE)
        out.append(model(z).softmax(-1).cpu().numpy())
    return np.vstack(out)

